
$include /etc/inputrc

set colored-stats On

"\e[5~": history-search-backward
"\e[6~": history-search-forward

# Go to position to add argument
"\eB": "\C-a\C-] \C-f"

# Delete first word
"\ee": " \C-b\C-k\C-a\C-] \C-f\C-k\C-y\ey\C-a\C-] \C-f\C-d\C-u\C-y\ey"

# To lower/upper/title with <C-x>
"\C-x\C-u": upcase-word
"\C-x\C-l": downcase-word
"\C-x\C-h": capitalize-word


$if Bash
    # Replace (/add) ls as first word
    "\ei": " \C-b\C-k\C-a\C-] \C-f\C-k\C-y\ey\C-a\C-] \C-d\C-wls\C-f\C-y\ey"
    "\eI": "\C-uls \C-y"

    # Replace (/add) cat as first word
    "\eo": " \C-b\C-k\C-a\C-] \C-f\C-k\C-y\ey\C-a\C-] \C-d\C-wcat\C-f\C-y\ey"
    "\eO": "\C-ucat \C-y"

    # Replace (/add) vim as first word
    "\ev": " \C-b\C-k\C-a\C-] \C-d\C-k\C-a$([ \"\C-e\" = vim ] && echo -n n; echo vim)\e\C-e\C-y\ey\C-a\C-] \C-f\C-u\C-y\C-y\ey"
    "\eV": "\C-uvim \C-y"

    # Replace (/add) xdg-open as first word
    "\ex": " \C-b\C-k\C-a\C-] \C-f\C-k\C-y\ey\C-a\C-] \C-d\C-wxdg-open\C-f\C-y\ey"
    "\eX": "\C-uxdg-open \C-y"

    # Copy arguments
    "\eC": "\C-a\C-] \C-k\C-y\C-h\C-y\C-h"

    # Add man/sudo in first position
    "\em": " \C-u \C-a\C-kman \C-y\C-a\ef\C-f\C-d\C-y\ey\C-h\C-a\ef\ef \C-b\C-k\n\C-y\ey\C-a\C-d\C-y\ey\C-h"
    "\es": " \C-usudo \C-y\C-h"
$endif

$if Python
    "\ei": "\C-adir(\C-e)\n"
    "\em": "\C-ahelp(\C-e)\n"
$endif

