STATUS_HELP_MSG="
 j / k		  down / up
 g / G		  first / last
 s		  jump to line
 d / u		  move selection down / up
 ctrl-f / ctrl-b  scroll preview down / up
 y		  yank file path

 space		  stage / unstage file
 A		  stage all files
 p		  stage file in patch mode
