#!/usr/bin/env bash
set -euo pipefail

SELECTED_COMMIT=""

if [ -n "${1:-}" ]; then
  if ! SELECTED_COMMIT=$(git rev-parse --verify "${1}^{commit}" 2>/dev/null); then
    echo "Error: '$1' is not a valid commit, branch, or tag." >&2
    exit 1
  fi
else
  if ! command -v fzf &>/dev/null; then
    echo "\`fzf\` is not installed, cannot select commit interactively." >&2
    exit 1
  fi

  LOG_FORMAT="%C(yellow)%h%C(reset) %C(auto)%d%C(reset) %s %C(green)(%cr)%C(reset) %C(blue)<%an>%C(reset)"

  fzf_fn_file="$HOME"/.config/fzf/fzf_fns
  if [[ -f "$fzf_fn_file" ]]; then
    # shellcheck disable=SC1090
    SELECTED_COMMIT=$(source "$fzf_fn_file" && __fzf_git_hashes)
  else
    SELECTED_COMMIT=$(git log --graph --color=always --format=format:"$LOG_FORMAT" "$@" |
      fzf --ansi --tiebreak=index | grep -o -E '[a-f0-9]{7,40}' | head -n1)
  fi
fi

if [ -z "$SELECTED_COMMIT" ]; then
  echo "No commit selected."
  exit 1
fi

git commit --fixup="$SELECTED_COMMIT"
GIT_SEQUENCE_EDITOR=true git rebase -i --autosquash "${SELECTED_COMMIT}~1"
